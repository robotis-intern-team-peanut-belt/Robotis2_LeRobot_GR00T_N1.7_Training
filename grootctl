#!/usr/bin/env bash
set -euo pipefail

TRAINING_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE="$(cd -- "${TRAINING_ROOT}/.." && pwd)"
LEROBOT_ROOT="${LEROBOT_ROOT:-${WORKSPACE}/lerobot}"
export LEROBOT_ROOT

if [[ "${GROOTCTL_SKIP_ACTIVATE:-0}" != "1" ]]; then
  if [[ -n "${VIRTUAL_ENV:-}" && "${VIRTUAL_ENV}" != "${LEROBOT_ROOT}/.venv" ]]; then
    echo "ERROR: another virtual environment is active: ${VIRTUAL_ENV}" >&2
    echo "Start a clean shell; never combine Isaac-GR00T and LeRobot environments." >&2
    exit 2
  fi
  if ! declare -F conda >/dev/null 2>&1; then
    CONDA_BASE="$(conda info --base)"
    source "${CONDA_BASE}/etc/profile.d/conda.sh"
  fi
  source "${LEROBOT_ROOT}/activate_lerobot.sh" >/dev/null
fi

exec python "${TRAINING_ROOT}/registry.py" "$@"
